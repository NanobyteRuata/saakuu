# Caddy obtains and renews the certificate itself; DOMAIN's A record must point at this host first.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}

# www needs its own DNS record pointing at this host; without one only this redirect is unavailable.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
