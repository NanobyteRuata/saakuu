# Production secrets. Copy to /opt/saakuu/.env on the server (chmod 600) and fill in.
# docker-compose.prod.yml sets DATABASE_URL, REDIS_URL and AUTH_URL from the values here.

# Public hostname, no scheme. Its A record must point at the server before the first start.
DOMAIN=178-128-91-83.sslip.io
# openssl rand -hex 24   (hex: it goes into a URL, so no characters that need escaping)
POSTGRES_PASSWORD=change-me

# Auth.js: openssl rand -base64 33
AUTH_SECRET=change-me-to-at-least-32-characters-long
# Google sign-in (optional). Redirect URI: https://<DOMAIN>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Who may sign up and read on GEMINI_API_KEY: comma-separated emails including your own, or * for anyone.
# The app refuses to start with this blank while GEMINI_API_KEY is set (docs/09 §8).
SIGNUP_ALLOWED_EMAILS=you@example.com

# Paid-tier Gemini key (docs/09 §8). Match the two limits to the key's real quota.
AI_PROVIDER=gemini
GEMINI_API_KEY=
EXTRACTION_CONCURRENCY=3
EXTRACTION_RPM=10
# Leave blank: personal keys stay switched off.
ENCRYPTION_KEY=

# Cloudflare R2. Endpoint is https://<account-id>.r2.cloudflarestorage.com; the browser uses it too,
# so the bucket needs the CORS rule in deploy/r2-cors.json.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=saakuu
S3_FORCE_PATH_STYLE=true
# Bucket for nightly database dumps (deploy/backup-db.sh); same credentials.
# Give it a lifecycle rule that deletes objects after PHOTO_DELETE_GRACE_DAYS days, no longer (docs/09 §2).
BACKUP_S3_BUCKET=saakuu-backups

# Email: log until there is a domain verified in Resend (links go to the app's log, so testers use Google
# sign-in). Then: EMAIL_TRANSPORT=resend, RESEND_API_KEY, and EMAIL_FROM on that domain.
EMAIL_TRANSPORT=log
RESEND_API_KEY=
EMAIL_FROM=SaaKuu <onboarding@resend.dev>

# Sized for a 2 GB host: photo jobs (HEIC decode, PDF render) are what run it out of memory. Raise on a bigger box.
WORKER_CONCURRENCY=2
MEDIA_CONCURRENCY=1
PHOTO_DELETE_GRACE_DAYS=30
