# Local development against `docker compose up postgres redis minio minio-init`.
# Host ports match the defaults in docker-compose.yml.

DATABASE_URL=postgresql://saakuu:saakuu@localhost:5433/saakuu
REDIS_URL=redis://localhost:6380

S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=saakuu
S3_SECRET_ACCESS_KEY=saakuu-secret
S3_BUCKET=saakuu
S3_FORCE_PATH_STYLE=true

WORKER_CONCURRENCY=3
