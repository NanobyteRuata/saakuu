# Local development against `docker compose up postgres redis minio minio-init`.
# Host ports match the defaults in docker-compose.yml.

DATABASE_URL=postgresql://saakuu:saakuu@localhost:5433/saakuu
REDIS_URL=redis://localhost:6380

S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=saakuu
S3_SECRET_ACCESS_KEY=saakuu-secret
S3_BUCKET=saakuu
S3_FORCE_PATH_STYLE=true
# Origin the browser uses for presigned upload/download URLs (defaults to S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=http://localhost:9002

WORKER_CONCURRENCY=3
# Photo processing jobs (HEIC decode, PDF render, resize) per worker process.
MEDIA_CONCURRENCY=2

# Extraction. AI_PROVIDER: gemini | fake (deterministic stub, no network; for local work and CI).
# The worker reads these once at start: restart it after changing them (tsx watch doesn't reload on .env edits).
AI_PROVIDER=gemini
GEMINI_API_KEY=
# fake provider only: ok | error | rate-limited | slow (answers after 90 s, to kill a worker mid-job).
AI_FAKE_BEHAVIOUR=ok
# Documents extracted at once, and extraction jobs started per minute (Gemini free tier is low).
EXTRACTION_CONCURRENCY=3
EXTRACTION_RPM=10

# Limits on sign-in, sign-up, email links and extraction requests (lib/rate-limit.ts). Leave on.
RATE_LIMIT_ENABLED=true
# Proxies in front of the app that append to X-Forwarded-For. The client address is this many entries from the right.
TRUSTED_PROXY_HOPS=1
# Days deleted photos (and photos of deleted documents and books) stay in storage before cleanup removes them.
# Keep this at least as long as database backups are kept (docs/09-operations.md).
PHOTO_DELETE_GRACE_DAYS=30

# Auth.js. Generate a secret with: openssl rand -base64 33
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Google OAuth (optional; the Google button is hidden when unset).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email: resend | log | test. `test` keeps mail in memory for Playwright (never in production).
EMAIL_TRANSPORT=log
RESEND_API_KEY=
# Until a domain is verified in Resend, onboarding@resend.dev only delivers to your own Resend account address.
EMAIL_FROM=SaaKuu <onboarding@resend.dev>
