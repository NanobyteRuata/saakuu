// Source of truth: docs/02-data-model.md
// IDs are cuid2. All timestamps are timestamptz.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth (Auth.js compatible) ----------

model User {
  id             String        @id @default(cuid(2))
  email          String        @unique
  emailVerified  DateTime?     @db.Timestamptz(3)
  name           String?
  image          String?
  passwordHash   String? // null for OAuth-only users
  // Phase 12: this user's own Gemini key, encrypted at rest by lib/crypto. Never logged, never
  // returned to the client; `aiApiKeyHint` is the last four characters, which is all the UI shows.
  aiApiKeyCipher String?
  aiApiKeyHint   String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  accounts       Account[]
  sessions       Session[]
  books          Book[]
  cellEdits      CellEdit[]
  creditEntries  CreditEntry[]
}

// ---------- Credits (Phase 22) ----------

enum CreditKind {
  SIGNUP
  GRANT
  PURCHASE
  USAGE
}

/// One line of a user's credit ledger (decision 81). A credit is a fixed slice of provider cost
/// (`lib/credits/rate.ts`), so one balance covers every kind of AI reading on any model. The balance is
/// the sum of a user's entries; what a queued or running reading is holding lives on the run
/// (`reservedMilliCredits`), not here, so a reading that fails leaves nothing to undo.
///
/// `runId` and `proposalId` are deliberately not foreign keys: this is a record of what was spent, and
/// it must outlive a deleted document (the same rule as `aiSpend`). Their uniqueness is what makes
/// charging a reading twice impossible.
model CreditEntry {
  id           String     @id @default(cuid(2))
  userId       String
  kind         CreditKind
  milliCredits Int // signed: positive for SIGNUP, GRANT and PURCHASE, negative for USAGE
  costMicroUsd Int? // USAGE: what the reading cost the deployment at list price
  inputTokens  Int?
  outputTokens Int?
  model        String?
  pages        Int?
  runId        String?    @unique
  proposalId   String?    @unique
  onceKey      String? // "signup": the free grant can only be given once per user
  note         String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, onceKey])
  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

model Account {
  id                String  @id @default(cuid(2))
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid(2))
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)
  purpose    String // EMAIL_VERIFY | PASSWORD_RESET

  @@unique([identifier, token])
}

// ---------- Book ----------

enum NumeralSystem {
  AUTO
  LATIN
  MYANMAR
}

enum DateEra {
  GREGORIAN
  BUDDHIST
  MYANMAR
}

model Book {
  id             String        @id @default(cuid(2))
  userId         String
  name           String
  defaultModel   String        @default("gemini-3.5-flash")
  numeralSystem  NumeralSystem @default(AUTO)
  dateEra        DateEra       @default(GREGORIAN)
  // export prefs
  blankToken     String        @default("")
  illegibleToken String        @default("?")
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?     @db.Timestamptz(3)

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  columns   OutputColumn[]
  templates Template[]
  documents Document[]
  rows      Row[]
  glossary  GlossaryEntry[]
  rules     ValidationRule[]
  batches   Batch[]

  @@index([userId, deletedAt])
}

enum ColumnType {
  TEXT
  NUMBER
  INTEGER
  DATE
  BOOLEAN
  ENUM
}

model OutputColumn {
  id         String     @id @default(cuid(2))
  bookId     String
  key        String // stable machine key, used as CSV header
  label      String
  dataType   ColumnType @default(TEXT)
  enumValues String[]   @default([])
  position   String // fractional index
  isRequired Boolean    @default(false)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  deletedAt  DateTime?  @db.Timestamptz(3)

  book     Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  mappings Mapping[]
  cells    Cell[]
  rules    ValidationRule[]

  @@unique([bookId, key])
  @@index([bookId, deletedAt])
}

model GlossaryEntry {
  id       String @id @default(cuid(2))
  bookId   String
  term     String // "1 1/2"
  meaning  String // "1 year and 6 months"
  position String
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
}

// ---------- Template ----------

enum TemplateKind {
  FORM
  TABLE
}

enum ConfigState {
  DRAFT
  READY
  CONFLICTED
}

model Template {
  id               String       @id @default(cuid(2))
  bookId           String
  name             String
  kind             TemplateKind
  configState      ConfigState  @default(DRAFT)
  modelOverride    String?
  doubleExtraction Boolean      @default(false) // deferred feature, schema ready
  anchors          String[]     @default([]) // printed strings expected on the page
  languageHint     String? // e.g. "my" (Burmese)
  instructions     String? // free-text template-level note to the AI
  sequenceFieldId  String? // TABLE only
  position         String
  // reserved for the deferred source-definition library:
  sourceDefId      String?
  sourceDefVersion Int?
  // Decision 78: when the part a reading depends on last changed (fields, groups, language hint,
  // instructions, sequence field). Mappings bump `updatedAt` but not this, so a test stays current.
  fieldsChangedAt  DateTime     @default(now()) @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?    @db.Timestamptz(3)

  book      Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  groups    FieldGroup[]
  fields    Field[]
  mappings  Mapping[]
  documents Document[]
  proposals FieldProposal[]

  @@index([bookId, deletedAt])
}

enum GroupSelection {
  NONE
  ONE_OF
  ANY_OF
}

enum NoneMarked {
  BLANK
  REVIEW
  ERROR
}

enum MultipleMarked {
  REVIEW
  ERROR
}

// A header on the paper. May span columns and nest (depth capped in code). Never holds raw values.
model FieldGroup {
  id             String         @id @default(cuid(2))
  templateId     String
  parentGroupId  String? // null = top level
  labelSource    String // as written on the paper
  labelMeaning   String? // English meaning
  position       String // shares one order with sibling fields (same parent)
  selection      GroupSelection @default(NONE) // tick columns encoding one / many answers
  noneMarked     NoneMarked     @default(REVIEW) // selection group with nothing ticked
  multipleMarked MultipleMarked @default(ERROR) // ONE_OF group with 2+ ticks
  note           String? // instruction to the AI
  template       Template       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parent         FieldGroup?    @relation("GroupNesting", fields: [parentGroupId], references: [id], onDelete: Restrict)
  children       FieldGroup[]   @relation("GroupNesting")
  fields         Field[]
  mappingInputs  MappingInput[]

  @@index([templateId])
  @@index([parentGroupId])
}

enum FieldType {
  TEXT
  NUMBER
  INTEGER
  DATE
  MARK
  CHOICE
  AGE
  FRACTION
}

enum FieldMode {
  EXTRACT
  SKIP
  MANUAL
}

model Field {
  id           String    @id @default(cuid(2))
  templateId   String
  groupId      String?
  labelSource  String // as written on the paper, any script
  labelMeaning String? // English meaning
  dataType     FieldType @default(TEXT)
  mode         FieldMode @default(EXTRACT)
  note         String? // human-language hint to the AI
  choices      String[]  @default([]) // CHOICE
  markSymbols  Json? // MARK: { "✓": true, "✗": false, "tally": "count" }
  typeOptions  Json? // Phase 6: settings for this field's type, e.g. DATE: { twoDigitYear, pivotYear }
  isSequence   Boolean   @default(false)
  position     String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3) // soft delete: raw values are kept as orphans

  template      Template       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  group         FieldGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  rawValues     RawValue[]
  mappingInputs MappingInput[]

  @@index([templateId, deletedAt])
}

// ---------- Mapping ----------

enum MappingKind {
  COPY
  CONCAT
  SPLIT
  CONSTANT
  EXPRESSION
}

enum MappingState {
  OK
  BROKEN
}

model Mapping {
  id             String       @id @default(cuid(2))
  templateId     String
  outputColumnId String
  kind           MappingKind
  state          MappingState @default(OK)
  separator      String? // CONCAT, default ", "
  splitBy        String? // SPLIT: delimiter
  splitIndex     Int? // SPLIT: 0-based part
  splitRegex     String? // SPLIT: alternative, first capture group
  constantValue  String? // CONSTANT
  expression     String? // EXPRESSION
  fillDown       Boolean      @default(true) // resolve ditto marks for this column
  position       String

  template     Template       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  outputColumn OutputColumn   @relation(fields: [outputColumnId], references: [id], onDelete: Cascade)
  inputs       MappingInput[]

  @@index([templateId])
  @@index([outputColumnId])
}

// Exactly one of fieldId / groupId is set. A group input is a selection group resolved to its answer
// (Phase 6); both null means its group was deleted, and the mapping is BROKEN.
model MappingInput {
  id           String      @id @default(cuid(2))
  mappingId    String
  fieldId      String?
  groupId      String? // Phase 6
  position     Int
  optionValues Json? // Phase 6, group inputs: { optionFieldId: output value }
  noneValue    String? // Phase 6, group inputs: exported when nothing is ticked
  mapping      Mapping     @relation(fields: [mappingId], references: [id], onDelete: Cascade)
  field        Field?      @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  group        FieldGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([mappingId, fieldId, position])
  @@index([fieldId])
  @@index([groupId])
}

// ---------- Documents & photos ----------

enum RunState {
  NEVER_RUN
  QUEUED
  RUNNING
  PARTIAL
  FAILED
  COMPLETE
}

enum ContentState {
  UNKNOWN
  HAS_CONTENT
  EMPTY
  NO_ROWS_FOUND
}

enum PhotoStatus {
  DRAFT
  QUEUED
  PROCESSING
  FAILED
  DONE
}

model Batch {
  // reserved; v1 creates a single implicit batch per upload
  id        String     @id @default(cuid(2))
  bookId    String
  label     String?
  metadata  Json? // clinic name, date received — can feed CONSTANT mappings later
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  book      Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([bookId])
}

model Document {
  id                   String       @id @default(cuid(2))
  bookId               String
  templateId           String
  batchId              String?
  label                String? // defaults to first photo filename
  position             String
  runState             RunState     @default(NEVER_RUN)
  contentState         ContentState @default(UNKNOWN)
  templateMatchScore   Float? // anchor detection, 0..1
  needsReview          Boolean      @default(false)
  isSpecimen           Boolean      @default(false) // Phase 15: a page uploaded to build a template against (decision 71)
  lastRunAt            DateTime?    @db.Timestamptz(3)
  lastModel            String?
  manualValues         Json? // MANUAL-mode field values: { fieldId: value }
  transformFlags       Json? // Phase 6: document review flags from the last transform: [{ kind, message }]
  contentChangedAt     DateTime?    @db.Timestamptz(3) // Phase 11: a page was transformed, replaced or added
  lastExtractedAt      DateTime?    @db.Timestamptz(3) // Phase 11: finishedAt of the latest COMPLETE run; only ever moves forward
  copyKey              String?      @unique // decision 78: idempotency key of the copy that created this document
  copiedFromDocumentId String? // decision 78: soft reference (no FK), counts earlier copies of a specimen
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?    @db.Timestamptz(3)

  book      Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  template  Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  batch     Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)
  photos    Photo[]
  runs      ExtractionRun[]
  records   RawRecord[]
  rows      Row[]
  proposals FieldProposal[]

  @@index([bookId, deletedAt])
  @@index([templateId, runState])
  @@index([templateId, isSpecimen])
  @@index([batchId])
  @@index([copiedFromDocumentId])
}

model Photo {
  id              String      @id @default(cuid(2))
  documentId      String
  pageIndex       Int
  originalKey     String // immutable object storage key
  workingKey      String? // max 2048px derived copy sent to the model
  thumbKey        String?
  mimeType        String
  width           Int
  height          Int
  byteSize        Int
  transform       Json? // { crop:{x,y,w,h}, rotate:number, deskew:number }
  status          PhotoStatus @default(DRAFT)
  errorMessage    String?
  // Phase 11: a re-shot page replaces its predecessor, which is soft-deleted rather than removed so
  // provenance from existing rows keeps resolving to an image until the document is read again.
  transformedAt   DateTime?   @db.Timestamptz(3) // null means untouched since upload
  replacedAt      DateTime?   @db.Timestamptz(3) // superseded by a re-shot page
  deletedAt       DateTime?   @db.Timestamptz(3) // soft delete; files age out through the normal tombstone path
  replacesPhotoId String? // the page this one was shot to replace; re-extraction supersedes its records
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, pageIndex])
  @@index([documentId, deletedAt])
  @@index([replacesPhotoId])
  // Storage cleanup asks, per page of listed objects, whether any photo still references a key (Phase 9).
  @@index([originalKey])
  @@index([workingKey])
  @@index([thumbKey])
}

// ---------- Storage lifecycle (Phase 9) ----------

enum StorageDeletionReason {
  PHOTO_DELETED // one page removed from a document
  DOCUMENT_PURGED // the photo's document or book was deleted longer ago than the grace period
}

/// Files of a deleted photo, kept until `deleteAfter` so a database restored from a backup still finds
/// its images. The cleanup job deletes `originalKey` and everything under books/{bookId}/photos/{photoId}/,
/// skipping any key a Photo row still references. No relations: the photo row is already gone.
model StorageDeletion {
  id          String                @id @default(cuid(2))
  bookId      String
  photoId     String                @unique
  originalKey String
  reason      StorageDeletionReason
  deleteAfter DateTime              @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)

  @@index([deleteAfter])
  @@index([originalKey])
}

// ---------- Extraction runs ----------

model ExtractionRun {
  id                   String    @id @default(cuid(2))
  documentId           String
  model                String
  promptVersion        String
  passIndex            Int       @default(0) // 1 for the second pass of double extraction
  idempotencyKey       String    @unique
  state                RunState  @default(QUEUED)
  startedAt            DateTime? @db.Timestamptz(3)
  finishedAt           DateTime? @db.Timestamptz(3)
  error                String?
  inputTokens          Int?
  outputTokens         Int?
  // Phase 23: the share of inputTokens spent on page images, the share of outputTokens spent
  // thinking. Null on runs older than the phase.
  imageTokens          Int?
  thinkingTokens       Int?
  thinkingLevel        String? // the AI_THINKING the reading was made at
  rawResponse          Json? // full model response, for debugging
  photoIds             String[]  @default([]) // Phase 5: pages sent in this model call, in page order
  // Phase 22: the estimate held against the owner's credits while this run is QUEUED or RUNNING.
  reservedMilliCredits Int       @default(0)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)

  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  records  RawRecord[]

  @@index([documentId, createdAt])
  @@index([state])
}

// ---------- Template proposals (Phase 16) ----------

/// One AI reading of a specimen that proposes the template's fields (decision 73: flat fields only).
/// A proposal, not a write: `items` is shown with per-field toggles and nothing reaches the tree until
/// the operator confirms, when `acceptedAt` is set. Kept apart from ExtractionRun because every run of a
/// document is read as an extraction (its run state, its raw layer), and a proposal is neither.
model FieldProposal {
  id                   String    @id @default(cuid(2))
  templateId           String
  documentId           String // the specimen that was read
  photoIds             String[]  @default([]) // pages sent, in page order
  model                String
  promptVersion        String
  idempotencyKey       String    @unique
  state                RunState  @default(QUEUED) // QUEUED, RUNNING, FAILED or COMPLETE
  startedAt            DateTime? @db.Timestamptz(3)
  finishedAt           DateTime? @db.Timestamptz(3)
  error                String?
  inputTokens          Int?
  outputTokens         Int?
  imageTokens          Int? // Phase 23, as on ExtractionRun
  thinkingTokens       Int?
  thinkingLevel        String?
  rawResponse          Json? // every model response, for debugging
  items                Json? // validated ProposedFieldDTO[] in paper order, once COMPLETE
  acceptedAt           DateTime? @db.Timestamptz(3)
  acceptedFieldIds     String[]  @default([])
  reservedMilliCredits Int       @default(0) // Phase 22: held while QUEUED or RUNNING, as on ExtractionRun
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([templateId, createdAt])
  @@index([documentId])
  @@index([state])
}

// ---------- Raw layer (verbatim, never normalised) ----------

enum RowType {
  DATA
  HEADER
  SUBTOTAL
  TOTAL
  NOTE
}

enum ValueState {
  OK
  ILLEGIBLE
  EMPTY
  DASH
  NOT_APPLICABLE
}

model RawRecord {
  id            String   @id @default(cuid(2))
  documentId    String
  runId         String
  recordIndex   Int // 0 for FORM; source row order for TABLE
  rowType       RowType  @default(DATA)
  struckThrough Boolean  @default(false)
  sequenceValue String? // verbatim value of the sequence field
  photoId       String? // which page this record came from
  bbox          Json? // { x, y, w, h } normalised 0..1 on that photo
  duplicateOf   String? // set by overlap dedupe
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  document Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  run      ExtractionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  values   RawValue[]
  rows     Row[]

  @@index([documentId, recordIndex])
  @@index([runId])
}

model RawValue {
  id           String     @id @default(cuid(2))
  rawRecordId  String
  fieldId      String
  valueText    String? // EXACTLY as read. Ditto marks stored as the literal token.
  altValueText String? // visible correction, or second-pass value
  state        ValueState @default(OK)
  isDitto      Boolean    @default(false)
  confidence   Float? // model self-report: a sort order, not a truth
  disagreement Boolean    @default(false) // double extraction mismatch
  photoId      String?
  bbox         Json? // normalised region; powers review crops

  record RawRecord @relation(fields: [rawRecordId], references: [id], onDelete: Cascade)
  field  Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([rawRecordId, fieldId])
  @@index([fieldId])
}

// ---------- Output layer (derived, human-edited) ----------

enum ValidationState {
  NONE
  WARNING
  ERROR
}

model Row {
  id          String    @id @default(cuid(2))
  bookId      String
  documentId  String
  rawRecordId String?
  position    String // fractional index; canonical manual order
  isVoid      Boolean   @default(false)
  voidReason  String? // Phase 6: SUBTOTAL | TOTAL | NOTE | STRUCK_THROUGH | ORPHANED when void by rule
  recordKey   String? // Phase 6: stable identity within the document ("form", "seq:12", "row:3")
  deletedAt   DateTime? @db.Timestamptz(3) // Phase 7: deleted by hand; a rebuild matches it and keeps it deleted
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  book      Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  document  Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  rawRecord RawRecord? @relation(fields: [rawRecordId], references: [id], onDelete: SetNull)
  cells     Cell[]

  @@index([bookId, position])
  @@index([documentId])
  @@index([rawRecordId])
}

model Cell {
  id              String          @id @default(cuid(2))
  rowId           String
  outputColumnId  String
  extractedValue  String? // post-transform, pre-human
  currentValue    String? // what exports
  state           ValueState      @default(OK)
  extractedState  ValueState      @default(OK) // Phase 7: state of extractedValue, so revert restores it
  buildIssues     Json? // Phase 7: [{ severity, message }] found by the transform for extractedValue
  isEdited        Boolean         @default(false)
  isReviewed      Boolean         @default(false)
  inherited       Boolean         @default(false) // resolved from a ditto mark
  confidence      Float?
  disagreement    Boolean         @default(false) // re-extraction differs from an edit
  validationState ValidationState @default(NONE)
  validationMsgs  String[]        @default([])
  reviewedAt      DateTime?       @db.Timestamptz(3) // Phase 12: when isReviewed became true
  reviewedVia     ReviewSource? // Phase 12: how it was reviewed
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  row    Row          @relation(fields: [rowId], references: [id], onDelete: Cascade)
  column OutputColumn @relation(fields: [outputColumnId], references: [id], onDelete: Cascade)
  edits  CellEdit[]

  @@unique([rowId, outputColumnId])
  @@index([outputColumnId, validationState])
  @@index([rowId])
  @@index([isReviewed, reviewedAt])
}

// Phase 12: how a cell came to be reviewed. Without this, one row-level mark stamps every cell in
// the row at the same instant and no timing figure derived from reviewedAt means anything (decision 57).
enum ReviewSource {
  CELL
  ROW
  ILLEGIBLE
}

enum CellEditKind {
  EDIT
  REVERT
  UNDO
}

model CellEdit {
  id            String       @id @default(cuid(2))
  cellId        String
  userId        String
  previousValue String?
  newValue      String?
  reason        String? // UI deferred; column present from v1
  kind          CellEditKind @default(EDIT) // Phase 7
  flags         Json? // Phase 7: { before: { state, isEdited, disagreement }, after: { ... } }, for undo
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  cell Cell @relation(fields: [cellId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cellId, createdAt])
  @@index([userId])
}

// ---------- Validation ----------

enum RuleKind {
  REQUIRED
  TYPE
  RANGE
  LENGTH
  REGEX
  ENUM
  UNIQUE
  CROSS_COLUMN
  MONOTONIC
}

enum RuleSeverity {
  WARNING
  ERROR
}

model ValidationRule {
  id             String       @id @default(cuid(2))
  bookId         String
  outputColumnId String?
  kind           RuleKind
  params         Json // { min, max, pattern, otherColumnId, operator, ... }
  message        String?
  severity       RuleSeverity @default(WARNING)
  enabled        Boolean      @default(true)

  book   Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  column OutputColumn? @relation(fields: [outputColumnId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([outputColumnId])
}
