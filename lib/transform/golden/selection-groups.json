{
  "description": "From ticks mappings give one answer: a value per tick, nothing ticked, several ticked, unreadable ticks, ticks under a sub-header, Any of",
  "input": {
    "kind": "TABLE",
    "sequenceFieldId": "fno",
    "fields": [
      { "id": "fno", "labelSource": "No.", "dataType": "INTEGER" },
      { "id": "fm", "labelSource": "လိင် › ကျား", "labelMeaning": "Sex › M", "dataType": "MARK" },
      { "id": "ff", "labelSource": "လိင် › မ", "labelMeaning": "Sex › F", "dataType": "MARK" },
      { "id": "fa", "labelSource": "RDT Test › Positive › A", "dataType": "MARK" },
      { "id": "fb", "labelSource": "RDT Test › Positive › B", "dataType": "MARK" },
      { "id": "fc", "labelSource": "RDT Test › Positive › C", "dataType": "MARK" },
      { "id": "fneg", "labelSource": "RDT Test › Neg.", "dataType": "MARK" },
      { "id": "ffever", "labelSource": "Fever", "dataType": "MARK" },
      { "id": "fcough", "labelSource": "Cough", "dataType": "MARK" }
    ],
    "columns": [{ "key": "no", "dataType": "INTEGER" }, { "key": "sex" }, { "key": "rdt" }, { "key": "symptoms" }],
    "mappings": [
      { "column": "no", "inputs": ["fno"] },
      {
        "column": "sex",
        "kind": "TICKS",
        "ticks": { "label": "လိင်", "selection": "ONE_OF", "noneMarked": "REVIEW", "multipleMarked": "ERROR" },
        "inputs": [{ "field": "fm", "value": "1" }, { "field": "ff", "value": "2" }]
      },
      {
        "column": "rdt",
        "kind": "TICKS",
        "ticks": { "label": "RDT Test", "selection": "ONE_OF", "noneMarked": "BLANK", "noneValue": "Not tested" },
        "inputs": [
          { "field": "fa", "value": "Positive › A" },
          { "field": "fb", "value": "Positive › B" },
          { "field": "fc", "value": "Positive › C" },
          { "field": "fneg", "value": "Neg." }
        ]
      },
      { "column": "symptoms", "kind": "TICKS", "ticks": { "selection": "ANY_OF", "noneMarked": "BLANK" }, "inputs": ["ffever", "fcough"] }
    ],
    "records": [
      { "id": "r1", "values": { "fno": "1", "fm": "✓", "ff": null, "fa": "✓", "ffever": "✓", "fcough": "✓" } },
      { "id": "r2", "values": { "fno": "2", "fm": "✓", "ff": "✓", "fneg": "✓" } },
      { "id": "r3", "values": { "fno": "3" } },
      { "id": "r4", "values": { "fno": "4", "ff": "✓", "fb": { "state": "ILLEGIBLE" } } },
      { "id": "r5", "values": { "fno": "5", "fm": { "text": "〃", "ditto": true }, "fc": "✓" } }
    ]
  },
  "expected": {
    "rows": [
      { "record": "r1", "key": "seq:1", "cells": { "no": "1", "sex": "1", "rdt": "Positive › A", "symptoms": "Fever, Cough" } },
      {
        "record": "r2",
        "key": "seq:2",
        "cells": {
          "no": "2",
          "sex": { "value": null, "error": ["Several options are ticked in “လိင်” (M, F), so none was picked."] },
          "rdt": "Neg.",
          "symptoms": null
        }
      },
      {
        "record": "r3",
        "key": "seq:3",
        "cells": {
          "no": "3",
          "sex": { "value": null, "warning": ["Nothing is ticked in “လိင်”."] },
          "rdt": "Not tested",
          "symptoms": null
        }
      },
      {
        "record": "r4",
        "key": "seq:4",
        "cells": {
          "no": "4",
          "sex": "2",
          "rdt": { "value": null, "state": "ILLEGIBLE", "warning": ["A tick in “RDT Test” couldn't be read, so the answer needs checking."] },
          "symptoms": null
        }
      },
      {
        "record": "r5",
        "key": "seq:5",
        "cells": { "no": "5", "sex": { "value": "1", "inherited": true }, "rdt": "Positive › C", "symptoms": null }
      }
    ],
    "flags": ["CELLS_FLAGGED: 3 cells were flagged while building rows."]
  }
}
