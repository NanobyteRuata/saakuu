# Local development against `docker compose up postgres redis minio minio-init`.
# Host ports match the defaults in docker-compose.yml.

DATABASE_URL=postgresql://saakuu:saakuu@localhost:5433/saakuu
REDIS_URL=redis://localhost:6380

S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=saakuu
S3_SECRET_ACCESS_KEY=saakuu-secret
S3_BUCKET=saakuu
S3_FORCE_PATH_STYLE=true
# Origin the browser uses for presigned upload/download URLs (defaults to S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=http://localhost:9002

WORKER_CONCURRENCY=3
# Photo processing jobs (HEIC decode, PDF render, resize) per worker process.
MEDIA_CONCURRENCY=2

# Auth.js. Generate a secret with: openssl rand -base64 33
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Google OAuth (optional; the Google button is hidden when unset).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email: resend | log | test. `test` keeps mail in memory for Playwright (never in production).
EMAIL_TRANSPORT=log
RESEND_API_KEY=
# Until a domain is verified in Resend, onboarding@resend.dev only delivers to your own Resend account address.
EMAIL_FROM=SaaKuu <onboarding@resend.dev>
